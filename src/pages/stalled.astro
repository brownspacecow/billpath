---
import BaseLayout from '../layouts/BaseLayout.astro';
import bills from '../data/bills.json';
const filter = Number(Astro.url.searchParams.get('days') || 30);
const stalled = (bills as any).filter((b: any) => b.lastActivityDaysAgo >= filter);
---
<BaseLayout title="Stalled Bills | BillPath">
  <h1 class="section-title">Stalled Bill Tracker</h1>
  <div class="flex gap-2 text-sm">
    <a href="/billpath/stalled?days=30">30+ Days</a>
    <a href="/billpath/stalled?days=60">60+ Days</a>
    <a href="/billpath/stalled?days=90">90+ Days</a>
  </div>
  <div class="mt-3 grid gap-3">
    {stalled.map((bill: any) => (
      <a href={`/billpath/bills/${bill.id}`} class="card block">
        <div class="font-semibold">{bill.number} — {bill.title}</div>
        <div>Current Stage: {bill.currentStage}</div>
        <div>No movement: {bill.lastActivityDaysAgo} days</div>
        <div>Status: Awaiting {bill.nextStage ?? 'final disposition'}</div>
      </a>
    ))}
  </div>
</BaseLayout>
