---
import BaseLayout from '../../layouts/BaseLayout.astro';
import committees from '../../data/committees.json';
import bills from '../../data/bills.json';

export function getStaticPaths() {
  return (committees as any).map((c: any) => ({ params: { id: c.id } }));
}

const committee = (committees as any).find((c: any) => c.id === Astro.params.id);
if (!committee) throw new Error('Committee not found');
const assigned = (bills as any).filter((b: any) => b.committee === committee.name);
---
<BaseLayout title={`${committee.name} | BillPath`}>
  <h1 class="section-title">{committee.name}</h1>
  <p>{committee.description}</p>
  <p>Leadership: {committee.leaders.join(', ')}</p>
  <h2 class="font-semibold mt-4">Pipeline Statistics</h2>
  <ul>
    <li>Bills Assigned: {assigned.length}</li>
    <li>Bills Awaiting Hearing: {assigned.filter((b: any) => b.currentStage === 'Committee Review').length}</li>
    <li>Bills Approved: {assigned.filter((b: any) => ['Passed Chamber','Signed Into Law'].includes(b.currentStage)).length}</li>
    <li>Bills Rejected: {assigned.filter((b: any) => b.currentStage === 'Vetoed').length}</li>
    <li>Stalled Bills: {assigned.filter((b: any) => b.lastActivityDaysAgo >= 30).length}</li>
  </ul>
</BaseLayout>
